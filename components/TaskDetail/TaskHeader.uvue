/* #ifndef APP */
/* TaskHeader - Checkbox 样式 */
.task-header checkbox .uni-checkbox-input {
	border-color: #42b983;
	width: 20px;
	height: 20px;
}

.task-header checkbox .uni-checkbox-input.uni-checkbox-input-checked {
	background-color: #42b983;
	border-color: #42b983;
}
