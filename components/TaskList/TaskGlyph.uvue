<template>
	<text class="task-glyph" :style="{ fontSize: size + 'px', color }">{{ glyph }}</text>
</template>

<script setup>
import { fontData } from '@/uni_modules/uni-icons/components/uni-icons/uniicons_file_vue.js'

const props = defineProps({
	type: { type: String, required: true },
	size: { type: Number, default: 16 },
	color: { type: String, default: '#6c757d' }
})
const glyph = computed(() => fontData.find(item => item.font_class === props.type)?.unicode || '')
</script>

<style>
@font-face {
	font-family: TaskGlyph;
	src: url('../../uni_modules/uni-icons/components/uni-icons/uniicons.ttf');
}
.task-glyph { font-family: TaskGlyph; flex-shrink: 0; }
</style>
