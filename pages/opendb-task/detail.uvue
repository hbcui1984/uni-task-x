function setAssignee() {
	const memberInfo = getAssigneeInfo(currentTaskAssignee.value)
	const memberName = memberInfo ? memberInfo.text : '未知'
	// 获取子任务名称
	const subTask = subTasks.value.find(t => t._id === currentTaskId.value)
	const subTaskTitle = subTask ? subTask.title : '子任务'

	db.collection('opendb-task').doc(currentTaskId.value).update({
		'assignee': currentTaskAssignee.value
	}).then(async (e) => {
		assigneePopup.value?.close()
		// 先刷新子任务列表，完成后刷新动态列表
