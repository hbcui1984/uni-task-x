async function finish(task) {
	// 检查任务 ID 是否有效
	if (!task._id || task._id.startsWith('temp_')) {
		uni.showToast({
			title: '任务正在保存中，请稍后',
			icon: 'none'
		})
		return
	}

	const newStatus = task.status > 0 ? 0 : 2
	const taskTitle = task.title
	try {
		const taskObj = uniCloud.importObject('task-co')
		const res = await taskObj.changeState(task._id, newStatus)
		if (res.errCode && res.errCode !== 0) {
			throw new Error(res.errMsg || '操作失败')
		}
		// 刷新子任务列表，完成后刷新动态列表
		await loadSubTask()
		// 数据库触发器会自动记录日志，这里只需刷新动态列表
		loadTaskLogs()
	} catch (err) {
		console.error('更新子任务状态失败:', err)
		uni.showToast({
			title: '操作失败',
			icon: 'none'
		})
	}
}

function setCurrentTaskId(taskId) {
	// 检查任务 ID 是否有效
	if (!taskId || taskId.startsWith('temp_')) {
		uni.showToast({ title: '任务正在保存中，请稍后', icon: 'none' })
		return
	}
	currentTaskId.value = taskId
}

function setDeadLine(val) {
	pickerOpen.value = false
	if (val !== oldDeadline.value) {
		const newDeadline = new Date(val).getTime()
		db.collection('opendb-task').doc(taskId.value).update({
			'deadline': newDeadline
		}).then((e) => {
			uni.showToast({ title: '截止日期已更新', icon: 'success' })
			// 数据库触发器会自动记录日志，这里只需刷新动态列表
			loadTaskLogs()
			oldDeadline.value = val
		})
	}
}

function clearDeadline() {
	deadline.value = ''
	db.collection('opendb-task').doc(taskId.value).update({
		'deadline': null
	}).then(() => {
		uni.showToast({ title: '截止日期已清除', icon: 'success' })
		loadTaskLogs()
		oldDeadline.value = ''
	})
}

function bindDateChange(e, subTaskId) {
	if (!subTaskId || subTaskId.startsWith('temp_')) return
	const timestamp = new Date(e.detail.value).getTime();
	db.collection('opendb-task').doc(subTaskId).update({
		'deadline': timestamp
	}).then((e) => {
		loadSubTask();
	}).catch((e) => {
		uni.showModal({
			title: '设置截止日期失败',
			content: e.message,
			showCancel: false
		})
	})
}

