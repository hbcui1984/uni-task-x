// 执行删除主任务（通过云对象，包含权限检查）
async function doDeleteTask() {
	try {
		const taskObj = uniCloud.importObject('task-co', { customUI: true })
		const result = await taskObj.deleteTask({
			taskId: taskId.value,
			project_id: projectId.value
		})
		if (result.errCode && result.errCode !== 0) {
			uni.showToast({
				title: result.errMsg || '删除失败',
				icon: 'none',
				duration: 3000
			})
			return
		}
		uni.showToast({ title: '任务已删除', icon: 'success' })
		schedule(() => {
			uni.navigateTo({
				url: '/pages/opendb-task/list?id=' + projectId.value
			})
		}, 500)
	} catch (err) {
		const errMsg = err.errMsg || err.message || '删除失败'
		uni.showToast({ title: errMsg, icon: 'none', duration: 3000 })
	}
}

function handleDelete() {
	uni.showModal({
		title: '删除确认',
		content: '确认删除此任务吗？此操作不可撤销。',
		confirmColor: '#e74c3c',
		success: (res) => {
			if (res.confirm) {
				doDeleteTask()
			}
		}
	})
}

function openTaskMenu() {
	uni.showActionSheet({
		itemList: ['编辑任务', '删除任务'],
		success: (res) => {
			if (res.tapIndex === 0) {
				handleUpdate()
			} else if (res.tapIndex === 1) {
				handleDelete()
			}
		}
	})
}

