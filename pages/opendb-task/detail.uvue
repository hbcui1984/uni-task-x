			}
		}
	})
}

// 开始内联编辑子任务
function startInlineEdit(id, title) {
	// 检查任务 ID 是否有效
	if (!id || id.startsWith('temp_')) {
		uni.showToast({ title: '任务正在保存中，请稍后', icon: 'none' })
		return
	}
	editingSubTaskId.value = id
	editTaskId.value = id
	editTaskContent.value = title
}

// 取消内联编辑
function cancelInlineEdit() {
	editingSubTaskId.value = ''
	editTaskId.value = ''
	editTaskContent.value = ''
}

// 保存内联编辑
async function saveSubTaskEdit() {
	if (!editTaskContent.value.trim()) {
		uni.showToast({ title: '标题不能为空', icon: 'none' })
		return
	}
	try {
		await db.collection('opendb-task').doc(editTaskId.value).update({
			title: editTaskContent.value.trim()
		})
		// 更新本地数据
		const index = subTasks.value.findIndex(t => t._id === editTaskId.value)
		if (index !== -1) {
			subTasks.value[index].title = editTaskContent.value.trim()
		}
		uni.showToast({ title: '修改成功', icon: 'success' })
		cancelInlineEdit()
	} catch (e) {
		uni.showToast({ title: '修改失败', icon: 'none' })
	}
}

// 处理编辑输入框失焦
function handleEditBlur() {
	// 延迟执行，避免与 confirm 事件冲突
	schedule(() => {
		// 如果还在编辑状态，说明不是按回车保存的，需要保存
		if (editingSubTaskId.value && editTaskContent.value.trim()) {
			saveSubTaskEdit()
		} else if (editingSubTaskId.value) {
			cancelInlineEdit()
		}
	}, 100)
}

