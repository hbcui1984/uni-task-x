	// 检查任务 ID 是否有效
	if (!taskId || taskId.startsWith('temp_')) {
		uni.showToast({ title: '任务正在保存中，请稍后', icon: 'none' })
		return
	}
	currentTaskId.value = taskId
	currentTaskAssignee.value = userId
	assigneePopup.value?.open()
}

