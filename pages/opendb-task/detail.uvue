function selectPriority(priorityValue) {
	// 如果相同则不更新
	if (priority.value === priorityValue) {
		closePriorityDropdown()
		return
	}

	// 保存旧值用于回滚
	const oldPriority = priority.value

	// 立即更新 UI 并关闭下拉列表
	priority.value = priorityValue
	closePriorityDropdown()

	// 异步更新后端
	db.collection('opendb-task').doc(taskId.value).update({
		priority: priorityValue
	}).then(() => {
		// 刷新动态列表
		schedule(() => {
			loadTaskLogs()
		}, 500)
	}).catch(e => {
		// 更新失败，回滚
		priority.value = oldPriority
		uni.showToast({ title: '设置失败，已恢复', icon: 'none' })
	})
}

// 分组下拉选择相关方法
function toggleGroupDropdown() {
	showGroupDropdown.value = !showGroupDropdown.value
	if (showGroupDropdown.value) {
		// 关闭其他下拉列表
		closeMainAssigneeDropdown()
		closeSubTaskAssigneeDropdown()
		closePriorityDropdown()
	}
}

function selectGroupInline(groupIdValue) {
	// 如果相同则不更新
	if (groupId.value === groupIdValue) {
		closeGroupDropdown()
		return
	}

	// 保存旧值用于回滚
	const oldGroupId = groupId.value

	// 立即更新 UI 并关闭下拉列表
	groupId.value = groupIdValue
	closeGroupDropdown()

	// 异步更新后端
	db.collection('opendb-task').doc(taskId.value).update({
		group_id: groupIdValue
	}).then(() => {
		// 刷新动态列表
		schedule(() => {
			loadTaskLogs()
		}, 500)
	}).catch(e => {
		// 更新失败，回滚
		groupId.value = oldGroupId
		uni.showToast({ title: '设置失败，已恢复', icon: 'none' })
	})
}

// 切换子任务负责人下拉列表
function toggleSubTaskAssigneeDropdown(taskId) {
	if (openSubTaskAssigneeId.value === taskId) {
		closeSubTaskAssigneeDropdown()
	} else {
		// 关闭其他下拉列表
		closeMainAssigneeDropdown()
		openSubTaskAssigneeId.value = taskId
	}
}

// 选择子任务负责人（乐观更新）
function selectSubTaskAssignee(taskId, memberId) {
	const index = subTasks.value.findIndex(t => t._id === taskId)
	if (index === -1) return

	// 保存旧值用于回滚
	const oldAssignee = subTasks.value[index].assignee ? [...subTasks.value[index].assignee] : []

	// 立即更新 UI 并关闭下拉列表
	if (memberId) {
		const member = members.value.find(m => m.value === memberId)
		subTasks.value[index].assignee = [{ _id: memberId, nickname: member?.text || '未知' }]
	} else {
		subTasks.value[index].assignee = []
	}
	closeSubTaskAssigneeDropdown()

	// 异步更新后端
	db.collection('opendb-task').doc(taskId).update({
		assignee: memberId
	}).catch(e => {
		// 更新失败，回滚
		subTasks.value[index].assignee = oldAssignee
		uni.showToast({ title: '设置失败，已恢复', icon: 'none' })
	})
}

