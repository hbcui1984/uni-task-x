function editComment() {
	if (!editCommentContent.value.trim()) {
		uni.showToast({ title: '请输入评论内容', icon: 'none' })
		return
	}

	if (editCommentContent.value.length > commentMaxLength) {
		uni.showToast({ title: `评论不能超过${commentMaxLength}字`, icon: 'none' })
		return
	}

	db.collection('task-comments').doc(editCommentId.value).update({
		content: editCommentContent.value
	}).then(e => {
		uni.showToast({ title: '评论修改成功', icon: 'success' })
		loadComments()
		commentPopup.value?.close()
		resetCommentPopup()
	}).catch(err => {
		console.error('评论修改失败:', err)
		uni.showToast({ title: err.message || '评论修改失败', icon: 'none' })
	})
}

function cancelEditComment() {
	commentPopup.value?.close()
	resetCommentPopup()
}

function delComment(id) {
	uni.showModal({
		title: '删除确认',
		content: '确认删除此评论吗？',
		confirmColor: '#e74c3c',
		success: async (res) => {
			if (res.confirm) {
				try {
					const taskObj = uniCloud.importObject('task-co')
					const result = await taskObj.deleteComment({ comment_id: id })
					if (result.errCode && result.errCode !== 0) {
						throw new Error(result.errMsg || '删除失败')
					}
					uni.showToast({ title: '评论已删除', icon: 'success' })
					loadComments()
					loadTaskLogs()
				} catch (err) {
					console.error('删除评论失败:', err)
					uni.showToast({ title: '删除失败', icon: 'none' })
				}
			}
		}
	})
}

// 判断是否是评论作者
function isCommentAuthor(commentUserId) {
	return currentUserId.value && commentUserId === currentUserId.value
}

// 处理评论输入（监听@符号）
function handleCommentInput(e) {
	const value = e.detail.value
	comment.value = value

	// 查找最后一个@符号的位置
	const lastAtIndex = value.lastIndexOf('@')

	if (lastAtIndex !== -1) {
		// 获取@后面的文本作为搜索关键词
		const afterAt = value.substring(lastAtIndex + 1)

		// 如果@后面没有空格，说明可能在输入用户名
		if (!afterAt.includes(' ')) {
			mentionKeyword.value = afterAt
			mentionPosition.value = lastAtIndex
			showMentionList.value = true
		} else {
			showMentionList.value = false
		}
	} else {
		showMentionList.value = false
	}
}

// 选择@提及的成员
function selectMention(member) {
	// 在@位置插入用户名
	const before = comment.value.substring(0, mentionPosition.value)
	const after = comment.value.substring(mentionPosition.value + 1 + mentionKeyword.value.length)
	comment.value = `${before}@${member.text} ${after}`

	// 记录被@的用户
	if (!mentionedUsers.value.find(u => u.value === member.value)) {
		mentionedUsers.value.push(member)
	}

	// 关闭弹出层
	showMentionList.value = false
	mentionKeyword.value = ''
}

// 关闭@提及列表
function closeMentionList() {
	showMentionList.value = false
	mentionKeyword.value = ''
}

// 解析评论内容，返回带有@高亮的片段数组
function parseCommentContent(content) {
	if (!content) return [{ type: 'text', content: '' }]

	// 匹配@用户名（@后跟非空格字符直到空格或结尾）
	const mentionRegex = /@([^\s]+)/g
	const parts = []
	let lastIndex = 0
	let match

	while ((match = mentionRegex.exec(content)) !== null) {
		// 添加@之前的普通文本
		if (match.index > lastIndex) {
			parts.push({
				type: 'text',
				content: content.substring(lastIndex, match.index)
			})
		}

		// 添加@用户名（高亮）
		parts.push({
			type: 'mention',
			content: match[0] // 包含@符号的完整匹配
		})

		lastIndex = match.index + match[0].length
	}

	// 添加剩余的普通文本
	if (lastIndex < content.length) {
		parts.push({
			type: 'text',
			content: content.substring(lastIndex)
		})
	}

	return parts.length > 0 ? parts : [{ type: 'text', content }]
}

// 打开分组选择弹窗
function openGroupPopup() {
	groupPopup.value?.open()
}

// 关闭分组选择弹窗
function closeGroupPopup() {
	groupPopup.value?.close()
}

// 选择分组
async function selectGroup(selectedId) {
	try {
		await db.collection('opendb-task').doc(taskId.value).update({
			group_id: selectedId
		})
		groupId.value = selectedId
		groupPopup.value?.close()
		uni.showToast({ title: '分组已更新', icon: 'success' })
		// 数据库触发器会自动记录日志，这里只需刷新动态列表
		loadTaskLogs()
	} catch (e) {
		uni.showToast({ title: '设置分组失败', icon: 'none' })
		console.error('selectGroup error', e)
	}
}

// 添加任务动态日志
async function addTaskLog(actionType, actionDetail, logTaskId = null) {
	try {
		const currentUser = uniCloud.getCurrentUserInfo()
		if (!currentUser || !currentUser.uid) {
			console.warn('未获取到当前用户信息，无法记录日志')
			return
		}

		await db.collection('opendb-task-logs').add({
			action_type: actionType,
			task_id: logTaskId || taskId.value,
			project_id: projectId.value,
			user_id: currentUser.uid,
			action_detail: actionDetail,
			create_time: Date.now()
		})

		// 刷新动态列表
		loadTaskLogs()
	} catch (e) {
		console.error('记录任务日志失败', e)
	}
}

// #ifdef WEB
function handleKeydown(event) {
	if (event.key !== 'Escape' && event.keyCode !== 27) return
	if (editingSubTaskId.value) cancelInlineEdit()
	if (addSubStatus.value) {
		addSubStatus.value = false
		subTaskInputFocus.value = false
	}
}
onPageShow(() => document.addEventListener('keydown', handleKeydown))
onPageHide(() => document.removeEventListener('keydown', handleKeydown))
// #endif

onLoad(options => {
	taskId.value = options.id || ''
	projectId.value = options.pid || ''
	currentUserId.value = getCurrentUserId()
})
onResize(() => {
	isWideScreen.value = uni.getWindowInfo().windowWidth >= BREAKPOINTS.TABLET
})
onReady(reloadDetail)
onUnload(() => {
	// #ifdef WEB
	document.removeEventListener('keydown', handleKeydown)
	// #endif
	timers.forEach(timer => clearTimeout(timer))
	timers.clear()
})
</script>

