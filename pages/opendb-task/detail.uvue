async function checkboxChange(e) {
	const newStatus = e.detail.value.length > 0 ? 2 : 0
	try {
		const taskObj = uniCloud.importObject('task-co')
		const res = await taskObj.changeState(taskId.value, newStatus)
		if (res.errCode && res.errCode !== 0) {
			throw new Error(res.errMsg || '操作失败')
		}
		uni.showToast({
			title: newStatus === 2 ? '任务已完成' : '任务已重新打开',
			icon: 'success'
		})
		// 刷新任务数据
		reloadDetail()
	} catch (err) {
		console.error('更新任务状态失败:', err)
		uni.showToast({
			title: '操作失败',
			icon: 'none'
		})
	}
}

async function addComment() {
	if (!comment.value.trim()) {
		uni.showToast({ title: '请输入评论内容', icon: 'none' })
		return
	}

	if (comment.value.length > commentMaxLength) {
		uni.showToast({ title: `评论不能超过${commentMaxLength}字`, icon: 'none' })
		return
	}
	uni.showLoading({})

	try {
		// 构建评论数据
		const commentData = {
			task_id: taskId.value,
			content: comment.value
		}

		// 添加被@的用户ID列表
		if (mentionedUsers.value.length > 0) {
			commentData.mentioned_users = mentionedUsers.value.map(u => u.value)
		}

		const taskObj = uniCloud.importObject('task-co')
		const result = await taskObj.addComment(commentData)

		if (result.errCode && result.errCode !== 0) {
			throw new Error(result.errMsg || '评论失败')
		}

		comment.value = ''
		mentionedUsers.value = []
		uni.hideLoading()
		uni.showToast({ title: '评论发表成功', icon: 'success' })
		loadComments()
		loadTaskLogs()
	} catch (err) {
		uni.hideLoading()
		console.error('评论失败:', err)
		uni.showToast({ title: '评论失败', icon: 'none' })
	}
}

function enableAddSub() {
	addSubStatus.value = true
	// 下一帧设置焦点
	nextTick(() => {
		subTaskInputFocus.value = true
	})
}

function addSubTask() {
	if (!subTaskForm.value.title.trim()) {
		addSubStatus.value = false
		subTaskInputFocus.value = false
		return
	}
	const subTaskTitle = subTaskForm.value.title
	// 清空输入框
	subTaskForm.value.title = ''

	// 生成临时 ID，用于乐观更新
	const tempId = 'temp_' + Date.now()

	// 立即在前端添加新子任务（乐观更新）
	subTasks.value.push({
		_id: tempId,
		title: subTaskTitle,
		status: 0,
		parent_id: taskId.value,
		assignee: []
	})

	// 重新聚焦输入框
	subTaskInputFocus.value = false
	nextTick(() => {
		subTaskInputFocus.value = true
	})

	// 后台异步写入数据库
	db.collection('opendb-task').add({
		parent_id: taskId.value,
		title: subTaskTitle,
		project_id: projectId.value
	}).then(e => {
		// 更新临时 ID 为真实 ID
		const realId = e.result?.id || e.result?._id || e.id || e._id
		const index = subTasks.value.findIndex(t => t._id === tempId)
		if (index !== -1 && realId) {
			subTasks.value[index]._id = realId
		}
		// 数据库触发器会自动记录日志，延迟刷新确保触发器完成
		schedule(() => {
			loadTaskLogs()
		}, 500)
	}).catch(e => {
		// 写入失败，移除乐观更新的数据
		const index = subTasks.value.findIndex(t => t._id === tempId)
		if (index !== -1) {
			subTasks.value.splice(index, 1)
		}
		if (e.code == "TOKEN_INVALID_TOKEN_EXPIRED") {
			uni.showModal({
				title: '添加子任务失败',
				content: '登录状态已过期，请重新登录',
				confirmText: '重新登录',
				success: (res) => {
					if (res.confirm) {
						uni.navigateTo({
							url: '/uni_modules/uni-id-pages/pages/login/login-withpwd'
						})
					}
				}
			})
		} else {
			uni.showToast({ title: '添加失败', icon: 'none' })
		}
	})
}

// 执行删除子任务（分离 async 逻辑确保错误正确捕获）
async function doDelSubTask(id) {
	try {
		const taskObj = uniCloud.importObject('task-co', { customUI: true })
		const result = await taskObj.deleteTask({ taskId: id })
		if (result.errCode && result.errCode !== 0) {
			uni.showToast({
				title: result.errMsg || '删除失败',
				icon: 'none',
				duration: 3000
			})
			return
		}
		uni.showToast({ title: '子任务已删除', icon: 'success' })
		await loadSubTask()
		loadTaskLogs()
	} catch (err) {
		// uniCloud 抛出的错误在 errMsg 中
		const errMsg = err.errMsg || err.message || '删除失败'
		uni.showToast({ title: errMsg, icon: 'none', duration: 3000 })
	}
}

function delSubTask(id) {
	// 检查任务 ID 是否有效
	if (!id || id.startsWith('temp_')) {
		uni.showToast({ title: '任务正在保存中，请稍后', icon: 'none' })
		return
	}
	uni.showModal({
		title: '删除确认',
		content: '确认删除此子任务吗？',
		confirmColor: '#e74c3c',
		success: (res) => {
			if (res.confirm) {
