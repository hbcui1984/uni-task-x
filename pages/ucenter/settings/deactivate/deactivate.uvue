<template>
	<view class="deactivate">
		<scroll-view class="notice-scroll" direction="vertical"
			<!-- #ifdef MP-ALIPAY -->
			:scroll-y="true"
			<!-- #endif -->
		>
			<view class="notice"><text v-for="line in notice" :key="line" class="words">{{ line }}</text></view>
		</scroll-view>
		<view class="button-group">
			<button class="action next" type="default" :disabled="busy" @click="nextStep">下一步</button>
			<button class="action" type="warn" :disabled="busy" @click="cancel">取消</button>
		</view>
	</view>
</template>

<script setup>
	const { mutations } = getCurrentInstance().proxy.$uniIdPagesStore
	const busy = ref(false)
	const notice = [
		'一、注销是不可逆操作，注销后：',
		'1. 帐号将无法登录、无法找回。',
		'2. 帐号所有信息都会清除（个人身份信息、粉丝数等；发布的作品、评论、点赞等；交易信息等），你的朋友将无法通过本应用帐号联系你，请自行备份相关信息和数据。',
		'二、重要提示',
		'1. 封禁帐号（永久封禁、社交封禁、直播权限封禁）不能申请注销。',
		'2. 注销后，你的身份证、三方帐号（微信、QQ、微博、支付宝）、手机号等绑定关系将解除，解除后可以绑定到其他帐号。',
		'3. 注销后，手机号可以注册新的帐号，新帐号不会存在之前帐号的任何信息（作品、粉丝、评论、个人信息等）。',
		'4. 注销本应用帐号前，需尽快处理帐号下的资金问题。',
		'5. 视具体帐号情况而定，注销最多需要7天。'
	]
	function cancel() { uni.navigateBack() }
	function nextStep() {
		if (busy.value) return
		busy.value = true
		uni.showModal({
			content: '已经仔细阅读注销提示，知晓可能带来的后果，并确认要注销',
			success: async ({ confirm }) => {
				if (!confirm) {
					busy.value = false
					cancel()
					return
				}
				try {
					const account = uniCloud.importObject('uni-id-co', { customUI: true })
					const result = await account.closeAccount()
					if (result.errCode) throw new Error(result.errMsg || '注销失败')
					uni.showToast({ title: '注销成功' })
					await mutations.logout()
				} catch (err) {
					uni.showToast({ title: err.errMsg || err.message || '注销失败', icon: 'none' })
				} finally {
					busy.value = false
				}
			},
			fail: () => { busy.value = false }
		})
	}
	onLoad(() => uni.setNavigationBarTitle({ title: '注销账号' }))
</script>

<style scoped>
	.deactivate { display: flex; flex-direction: column; flex: 1; height: 100%; }
	.notice-scroll { flex: 1; }
	.notice { display: flex; flex-direction: column; padding: 12px 16px; }
	.words { color: #333333; font-size: 14px; line-height: 23px; margin-bottom: 6px; }
	.button-group { display: flex; flex-direction: row; align-items: center; justify-content: space-around; padding: 10px 12px; border-top: 1px solid #e4e6ec; background-color: #ffffff; }
	.action { width: 42%; border-radius: 24px; font-size: 16px; }
	.next { color: #e64340; border: 1px solid #e64340; }
</style>
